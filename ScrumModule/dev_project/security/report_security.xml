<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Anyone in the company can send reports and only sees their own;
         the dev team (Project users) sees them all. -->
    <record id="rule_report_own" model="ir.rule">
        <field name="name">Reports: own reports</field>
        <field name="model_id" ref="model_dev_report" />
        <field name="domain_force">[('reporter_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="rule_report_dev_team" model="ir.rule">
        <field name="name">Reports: dev team sees all</field>
        <field name="model_id" ref="model_dev_report" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
    </record>
    <record id="rule_report_company" model="ir.rule">
        <field name="name">Reports: multi-company</field>
        <field name="model_id" ref="model_dev_report" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
