<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project form (used by both apps): Dev buttons and tabs. -->
    <record id="project_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.dev</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dev_board" type="object" class="oe_stat_button" icon="fa-columns" string="Board" invisible="not dev_is_software" />
                <button name="action_dev_backlog" type="object" class="oe_stat_button" icon="fa-list-ol" string="Backlog" invisible="not dev_is_software" />
                <button name="action_dev_sprints" type="object" class="oe_stat_button" icon="fa-refresh" invisible="not dev_is_software">
                    <field name="dev_sprint_count" widget="statinfo" string="Sprints" />
                </button>
                <button name="action_dev_open_issues" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not dev_is_software">
                    <field name="dev_open_issue_count" widget="statinfo" string="Open Issues" />
                </button>
            </xpath>
            <!-- Odoo's "Tasks" button: software projects use "Open Issues" instead. -->
            <xpath expr="//button[@name='action_view_tasks']" position="attributes">
                <attribute name="invisible">dev_is_software</attribute>
            </xpath>
            <!-- Software projects call their tasks "Issues" and don't use tags. -->
            <field name="label_tasks" position="attributes">
                <attribute name="invisible">dev_is_software</attribute>
            </field>
            <field name="tag_ids" position="attributes">
                <attribute name="invisible">dev_is_software</attribute>
            </field>
            <!-- Tabs: Development | Milestones | Sprints | Components | Description | Settings.
                 Milestones, Sprints and Components only show on software projects. -->
            <xpath expr="//notebook/page[@name='description']" position="before">
                <page name="dev" string="Development">
                    <group>
                        <group>
                            <field name="dev_is_software" />
                            <field name="dev_key" placeholder="Filled in from the name, e.g. WEB" readonly="dev_issue_sequence"
                                   required="dev_is_software" invisible="not dev_is_software" />
                            <field name="dev_issue_sequence" invisible="1" />
                            <field name="dev_repository_url" widget="url" placeholder="https://github.com/company/project"
                                   invisible="not dev_is_software" />
                        </group>
                        <group invisible="not dev_is_software">
                            <field name="dev_running_sprint_id" />
                            <field name="dev_open_bug_count" />
                        </group>
                    </group>
                </page>
                <page name="dev_milestones" string="Milestones" invisible="not dev_is_software">
                    <field name="milestone_ids" context="{'default_project_id': id, 'form_view_ref': 'dev_addons.milestone_form'}">
                        <tree decoration-muted="is_reached" decoration-danger="is_deadline_exceeded">
                            <field name="name" />
                            <field name="dev_version" optional="show" />
                            <field name="deadline" />
                            <field name="dev_sprint_count" string="Sprints" />
                            <field name="dev_issue_count" string="Issues" />
                            <field name="dev_progress" widget="progressbar" />
                            <field name="is_reached" string="Complete" widget="boolean" />
                            <field name="is_deadline_exceeded" column_invisible="1" />
                        </tree>
                    </field>
                </page>
                <page name="dev_sprints" string="Sprints" invisible="not dev_is_software">
                    <field name="dev_sprint_ids" context="{'default_project_id': id, 'dev_reload_project': True}">
                        <tree decoration-info="state == 'running'" decoration-muted="state == 'closed'">
                            <field name="name" />
                            <field name="milestone_id" optional="show" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="progress" widget="progressbar" />
                            <field name="state" widget="badge" decoration-success="state == 'running'" decoration-info="state == 'planned'" />
                        </tree>
                    </field>
                </page>
                <page name="dev_modules" string="Components" invisible="not dev_is_software">
                    <field name="dev_module_ids" context="{'default_project_id': id}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" placeholder="e.g. Login" />
                            <field name="lead_id" widget="many2one_avatar_user" options="{'no_create': True}" />
                            <field name="issue_count" string="Issues" />
                            <field name="open_count" string="Open" />
                            <field name="bug_count" string="Open Bugs" />
                            <button name="action_view_issues" type="object" string="View Issues" class="btn-link" invisible="not id" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Dev Projects' own project list and kanban. -->
    <record id="project_list" model="ir.ui.view">
        <field name="name">dev.project.list</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree>
                <field name="dev_key" />
                <field name="name" />
                <field name="user_id" string="Project Manager" widget="many2one_avatar_user" optional="show" />
                <field name="dev_running_sprint_id" optional="show" />
                <field name="dev_open_issue_count" />
                <field name="dev_open_bug_count" />
                <field name="dev_sprint_count" string="Sprints" optional="hide" />
                <field name="dev_repository_url" widget="url" optional="hide" />
                <field name="company_id" column_invisible="1" />
            </tree>
        </field>
    </record>

    <record id="project_kanban" model="ir.ui.view">
        <field name="name">dev.project.kanban</field>
        <field name="model">project.project</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="color" />
                <field name="dev_running_sprint_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                            <div class="oe_kanban_details p-2">
                                <div>
                                    <span class="badge text-bg-secondary me-2"><field name="dev_key" /></span>
                                    <strong class="fs-4"><field name="name" /></strong>
                                </div>
                                <div class="small mt-1" t-if="record.dev_running_sprint_id.raw_value">
                                    <i class="fa fa-refresh me-1" title="Running sprint" /><field name="dev_running_sprint_id" />
                                </div>
                                <div class="d-flex gap-2 mt-3 flex-wrap">
                                    <a name="action_dev_board" type="object" role="button" class="btn btn-sm btn-primary">
                                        <i class="fa fa-columns me-1" title="Board" />Board
                                    </a>
                                    <a name="action_dev_backlog" type="object" role="button" class="btn btn-sm btn-light">
                                        <i class="fa fa-list-ol me-1" title="Backlog" />Backlog
                                    </a>
                                    <a name="action_dev_open_issues" type="object" role="button" class="btn btn-sm btn-light">
                                        <i class="fa fa-tasks me-1" title="Open issues" /><field name="dev_open_issue_count" /> Open Issues
                                    </a>
                                    <a name="action_dev_bugs" type="object" role="button" class="btn btn-sm btn-light">
                                        <i class="fa fa-bug me-1" title="Open bugs" /><field name="dev_open_bug_count" /> Open Bugs
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('dev_is_software', '=', True)]</field>
        <field name="context">{'default_dev_is_software': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first project</p>
            <p>Software projects (shared with the Project app, which hides them by default). Each one gets a key
               (like WEB) used to number its issues.</p>
        </field>
    </record>
    <record id="action_project_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_kanban" />
        <field name="act_window_id" ref="action_project" />
    </record>
    <record id="action_project_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="project_list" />
        <field name="act_window_id" ref="action_project" />
    </record>
</odoo>
