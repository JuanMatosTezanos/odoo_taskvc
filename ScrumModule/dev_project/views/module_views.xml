<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_list" model="ir.ui.view">
        <field name="name">dev.module.list</field>
        <field name="model">dev.module</field>
        <field name="arch" type="xml">
            <tree sample="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="project_id" optional="show" />
                <field name="lead_id" widget="many2one_avatar_user" optional="show" />
                <field name="issue_count" string="Issues" />
                <field name="open_count" string="Open" />
                <field name="bug_count" string="Open Bugs" optional="show" />
                <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="module_form" model="ir.ui.view">
        <field name="name">dev.module.form</field>
        <field name="model">dev.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issues" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not id">
                            <field name="issue_count" widget="statinfo" string="Issues" />
                        </button>
                    </div>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="e.g. Login" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}" readonly="id" />
                            <field name="lead_id" widget="many2one_avatar_user" options="{'no_create': True}" />
                        </group>
                        <group>
                            <field name="open_count" />
                            <field name="bug_count" />
                            <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </group>
                    </group>
                    <notebook>
                        <page name="issues" string="Issues">
                            <field name="task_ids" context="{'default_project_id': project_id, 'default_dev_module_id': id, 'form_view_ref': 'project.view_task_form2'}">
                                <tree>
                                    <field name="dev_issue_type" />
                                    <field name="dev_key" />
                                    <field name="name" widget="name_with_subtask_count" />
                                    <field name="dev_sprint_id" optional="show" />
                                    <field name="milestone_id" optional="show" />
                                    <field name="dev_assignee_id" widget="many2one_avatar_user" />
                                    <field name="dev_priority" widget="priority" />
                                    <field name="dev_status" column_invisible="1" />
                                    <field name="stage_id" widget="badge" decoration-success="dev_status == 'done'" decoration-info="dev_status == 'in_progress'" decoration-warning="dev_status == 'review'" />
                                </tree>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" placeholder="What this part of the software covers..." />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="module_search" model="ir.ui.view">
        <field name="name">dev.module.search</field>
        <field name="model">dev.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="project_id" />
                <field name="lead_id" />
                <filter name="my_modules" string="I Lead" domain="[('lead_id', '=', uid)]" />
                <separator />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}" />
                    <filter name="group_lead" string="Lead" context="{'group_by': 'lead_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_module" model="ir.actions.act_window">
        <field name="name">Components</field>
        <field name="res_model">dev.module</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('project_id.dev_is_software', '=', True)]</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first component</p>
            <p>Components are the parts of your software, e.g. Login, Payments or Camera.
               Pick one on each issue to see what every part of the product needs.</p>
        </field>
    </record>
</odoo>
