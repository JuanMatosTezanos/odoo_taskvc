<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a "Dev Projects" section to the Project settings page (Settings > Project). -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dev_projects</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='tasks_management']" position="after">
                <block title="Dev Projects" id="dev_projects_settings">
                    <setting id="dev_default_columns_setting" help="Give new software projects the To Do, In Progress, In Review and Done board columns">
                        <field name="dev_default_columns" />
                        <div class="mt8">
                            <button name="%(dev_addons.action_stage)d" type="action" string="Board Columns" icon="oi-arrow-right" class="btn-link" />
                        </div>
                    </setting>
                    <setting id="dev_sprint_duration_setting" string="Default Sprint Length" help="Number of days a new sprint lasts">
                        <field name="dev_sprint_duration" />
                    </setting>
                    <setting id="dev_tech_image_dir_setting" string="Technology Logo Folder" help="Folder on the server with logos named after technologies (e.g. Python.png)">
                        <field name="dev_tech_image_dir" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
