<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.technology_list" model="ir.ui.view">
            <field name="name">Manage Technology List</field>
            <field name="model">manage.technology</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="photo" widget="image" options="{'size': [32, 32]}" />
                    <field name="name" />
                    <field name="description" optional="show" />
                    <field name="developer_count" string="Developers" />
                    <field name="task_count" string="Tasks" />
                </tree>
            </field>
        </record>

        <record id="manage.technology_kanban" model="ir.ui.view">
            <field name="name">Manage Technology Kanban</field>
            <field name="model">manage.technology</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('manage.technology', 'photo', record.id.raw_value)" alt="Logo" class="o_image_64_contain" />
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name" /></strong>
                                    <div class="text-muted text-truncate"><field name="description" /></div>
                                    <div class="mt-2 small">
                                        <span class="me-3"><i class="fa fa-users me-1" title="Developers" /><field name="developer_count" /> devs</span>
                                        <span><i class="fa fa-tasks me-1" title="Tasks" /><field name="task_count" /> tasks</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="manage.technology_form" model="ir.ui.view">
            <field name="name">Manage Technology Form</field>
            <field name="model">manage.technology</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="photo" widget="image" class="oe_avatar" />
                        <div class="oe_title">
                            <label for="name" />
                            <h1><field name="name" placeholder="e.g. Python" /></h1>
                        </div>
                        <group>
                            <field name="color" widget="color_picker" />
                        </group>
                        <notebook>
                            <page name="description" string="Description">
                                <field name="description" />
                            </page>
                            <page name="developers" string="Developers">
                                <field name="developers" readonly="1">
                                    <tree>
                                        <field name="name" />
                                        <field name="email" />
                                    </tree>
                                </field>
                            </page>
                            <page name="tasks" string="Tasks">
                                <field name="task">
                                    <tree>
                                        <field name="code" />
                                        <field name="name" />
                                        <field name="project" />
                                        <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="manage.action_technology_window" model="ir.actions.act_window">
            <field name="name">Technologies</field>
            <field name="res_model">manage.technology</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a technology</p>
                <p>Type a name like "Python" and its logo is loaded automatically when available.</p>
            </field>
        </record>

        <menuitem id="manage.menu_1_technology_list" name="Technologies" parent="manage.menu_team" action="manage.action_technology_window" sequence="20" />
    </data>
</odoo>
