<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.project_form" model="ir.ui.view">
            <field name="name">Manage Project Form</field>
            <field name="model">manage.project</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="histories" />
                    </group>
                </form>
            </field>
        </record>

        <record id="manage.action_project_window" model="ir.actions.act_window">
            <field name="name">Manage Project Window</field>
            <field name="res_model">manage.project</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="manage.menu_1_project_list" name="Projects" parent="manage.menu_1" action="manage.action_project_window" />
    </data>
</odoo>