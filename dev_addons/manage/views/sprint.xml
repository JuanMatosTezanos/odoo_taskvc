<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.sprint_list" model="ir.ui.view">
            <field name="name">Manage Sprint List</field>
            <field name="model">manage.sprint</field>
            <field name="arch" type="xml">
                <tree decoration-info="active" decoration-muted="not active" decoration-warning="duration &lt; 15">
                    <field name="name" />
                    <field name="project" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="duration" sum="Total" />
                    <field name="task_count" string="Tasks" />
                    <field name="progress" widget="progressbar" />
                    <field name="active" widget="boolean_toggle" readonly="1" string="Running" />
                </tree>
            </field>
        </record>

        <record id="manage.sprint_form" model="ir.ui.view">
            <field name="name">Manage Sprint Form</field>
            <field name="model">manage.sprint</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Running" bg_color="text-bg-success" invisible="not active" />
                        <widget name="web_ribbon" title="Not running" bg_color="text-bg-secondary" invisible="active" />
                        <field name="active" invisible="1" />
                        <div class="oe_title">
                            <label for="name" />
                            <h1><field name="name" placeholder="e.g. Sprint 1" /></h1>
                        </div>
                        <group>
                            <group string="Planning">
                                <field name="project" />
                                <field name="start_date" />
                                <label for="duration" />
                                <div class="o_row">
                                    <field name="duration" /> <span>days</span>
                                </div>
                                <field name="end_date" />
                            </group>
                            <group string="Progress">
                                <field name="task_count" string="Tasks" />
                                <field name="progress" widget="progressbar" />
                            </group>
                        </group>
                        <notebook>
                            <page name="tasks" string="Tasks">
                                <field name="tasks">
                                    <tree>
                                        <field name="code" />
                                        <field name="name" />
                                        <field name="history" />
                                        <field name="developer" widget="many2many_tags_avatar" />
                                        <field name="priority" widget="priority" />
                                        <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                                    </tree>
                                </field>
                            </page>
                            <page name="description" string="Description">
                                <field name="description" placeholder="Sprint goal..." />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="manage.sprint_calendar" model="ir.ui.view">
            <field name="name">Manage Sprint Calendar</field>
            <field name="model">manage.sprint</field>
            <field name="arch" type="xml">
                <calendar string="Sprints" date_start="start_date" date_stop="end_date" color="project" mode="month" quick_create="0">
                    <field name="name" />
                    <field name="project" filters="1" />
                </calendar>
            </field>
        </record>

        <record id="manage.sprint_search" model="ir.ui.view">
            <field name="name">Manage Sprint Search</field>
            <field name="model">manage.sprint</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="project" />
                    <filter name="running" string="Running" domain="[('active', '=', True)]" />
                    <filter name="not_running" string="Not Running" domain="[('active', '=', False)]" />
                    <group expand="0" string="Group By">
                        <filter name="group_project" string="Project" context="{'group_by': 'project'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="manage.cron_update_sprints" model="ir.cron">
            <field name="name">Update Sprint Active Status</field>
            <field name="model_id" ref="model_manage_sprint" />
            <field name="state">code</field>
            <field name="code">model.cron_update_sprints()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>



        <record id="manage.action_sprint_window" model="ir.actions.act_window">
            <field name="name">Sprints</field>
            <field name="res_model">manage.sprint</field>
            <field name="view_mode">tree,calendar,form</field>
            <!-- "active" is computed, so show finished sprints too instead of hiding them -->
            <field name="context">{'active_test': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Plan your first sprint</p>
                <p>New tasks are added automatically to the running sprint of their project.</p>
            </field>
        </record>

        <menuitem id="manage.menu_1_sprint_list" name="Sprints" parent="manage.menu_1" action="manage.action_sprint_window" sequence="30" />
    </data>
</odoo>
