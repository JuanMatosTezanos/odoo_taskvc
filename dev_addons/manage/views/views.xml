<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Developer form: partner form plus a "Developer" tab and smart buttons -->
        <record id="manage.devs_partner_form" model="ir.ui.view">
            <field name="name">Manage Developer Form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_dev_tasks" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not is_dev">
                        <field name="dev_task_count" widget="statinfo" string="Tasks" />
                    </button>
                    <button name="action_view_dev_bugs" type="object" class="oe_stat_button" icon="fa-bug" invisible="not is_dev">
                        <field name="dev_bug_count" widget="statinfo" string="Bugs" />
                    </button>
                    <button name="action_view_dev_improvements" type="object" class="oe_stat_button" icon="fa-lightbulb-o" invisible="not is_dev">
                        <field name="dev_improvement_count" widget="statinfo" string="Improvements" />
                    </button>
                </xpath>
                <xpath expr="//sheet/notebook" position="before">
                    <group invisible="not is_dev">
                        <group>
                            <field name="access_level" readonly="id and access_level" required="is_dev" placeholder="12345678A" />
                            <field name="last_login" />
                        </group>
                        <group>
                            <field name="technologies" widget="many2many_tags" options="{'color_field': 'color'}" />
                            <field name="is_dev" invisible="True" />
                        </group>
                    </group>
                </xpath>
                <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="before">
                    <page name="dev_tasks" string="Tasks" invisible="not is_dev">
                        <field name="task" context="{'current_developer': id}">
                            <tree>
                                <field name="name" />
                                <field name="project" />
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                                <field name="priority" widget="priority" />
                            </tree>
                        </field>
                    </page>
                    <page name="dev_bugs" string="Bugs" invisible="not is_dev">
                        <field name="bugs">
                            <tree>
                                <field name="name" />
                                <field name="project" />
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                                <field name="priority" widget="priority" />
                            </tree>
                        </field>
                    </page>
                    <page name="dev_improvements" string="Improvements" invisible="not is_dev">
                        <field name="improvements">
                            <tree>
                                <field name="name" />
                                <field name="project" />
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="manage.devs_partner_tree" model="ir.ui.view">
            <field name="name">Manage Developer List</field>
            <field name="model">res.partner</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="access_level" />
                    <field name="email" optional="show" />
                    <field name="phone" optional="hide" />
                    <field name="technologies" widget="many2many_tags" options="{'color_field': 'color'}" />
                    <field name="dev_task_count" string="Tasks" optional="show" />
                    <field name="dev_bug_count" string="Bugs" optional="show" />
                    <field name="last_login" optional="show" />
                </tree>
            </field>
        </record>

        <record id="manage.devs_partner_search" model="ir.ui.view">
            <field name="name">Manage Developer Search</field>
            <field name="model">res.partner</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="access_level" />
                    <field name="technologies" />
                    <filter name="with_tasks" string="With Tasks" domain="[('task', '!=', False)]" />
                    <filter name="with_bugs" string="With Bugs" domain="[('bugs', '!=', False)]" />
                </search>
            </field>
        </record>

        <record id="manage.action_developer_window" model="ir.actions.act_window">
            <field name="name">Developers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_dev','=',True)]</field>
            <field name="context">{'default_is_dev': True}</field>
            <field name="search_view_id" ref="manage.devs_partner_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add your first developer</p>
                <p>Developers can be assigned to tasks, bugs and improvements.</p>
            </field>
        </record>

        <record id="manage.action_view_developer_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="0" />
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="base.res_partner_kanban_view" />
            <field name="act_window_id" ref="manage.action_developer_window" />
        </record>

        <record id="manage.action_view_developer_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="manage.devs_partner_tree" />
            <field name="act_window_id" ref="manage.action_developer_window" />
        </record>

        <record id="manage.action_view_developer_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="manage.devs_partner_form" />
            <field name="act_window_id" ref="manage.action_developer_window" />
        </record>

        <!-- Menu structure -->
        <menuitem id="manage.menu_root" name="Software Projects" web_icon="manage,static/description/icon.png" sequence="10" />
        <menuitem id="manage.menu_1" name="Planning" parent="manage.menu_root" sequence="10" />
        <menuitem id="manage.menu_work" name="Work Items" parent="manage.menu_root" sequence="20" />
        <menuitem id="manage.menu_team" name="Team" parent="manage.menu_root" sequence="30" />

        <menuitem id="manage.menu_1_devs_list" name="Developers" parent="manage.menu_team" action="manage.action_developer_window" sequence="10" />
    </data>
</odoo>
