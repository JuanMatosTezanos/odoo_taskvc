<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="manage.devs_partner_form" model="ir.ui.view">
            <field name="name">manage developer form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
                    <page name="Devs" string="Devs" invisible="not is_dev">
                        <group>
                            <group>
                                <field name="technologies" />
                                <field name="is_dev" invisible="True" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <!-- actions opening views on models -->
        <record id="manage.action_technology_window" model="ir.actions.act_window">
            <field name="name">manage technology window</field>
            <field name="res_model">manage.technology</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="manage.action_developer_window" model="ir.actions.act_window">
            <field name="name">manage developer window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_dev','=',True)]</field>
            <field name="context">{'default_is_dev': True}</field>
        </record>
        #When the user opens the Developer window, which view should Odoo show?

        <record id="manage.action_view_developer_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="base.view_partner_tree" />
            <field name="act_window_id" ref="manage.action_developer_window" />
        </record>

        <record id="manage.action_view_developer_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="manage.devs_partner_form" />
            <field name="act_window_id" ref="manage.action_developer_window" />
        </record>
        <!-- server action to the one above -->
        <!--
    <record model="ir.actions.server" id="manage.action_server">
      <field name="name">manage server</field>
      <field name="model_id" ref="model_manage_manage"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->
        <!-- Top menu item -->
        <menuitem id="manage.menu_root" name="Manage" />
        <!-- menu categories -->
        <menuitem id="manage.menu_1" name="Management" parent="manage.menu_root" />
        <!--
    <menuitem name="manage" id="manage.menu_root"/>
-->
        <!-- actions -->
        <menuitem id="manage.menu_1_technology_list" name="Technologies" parent="manage.menu_1" action="manage.action_technology_window" />

        <menuitem id="manage.menu_1_devs_list" name="Developers" parent="manage.menu_1" action="manage.action_developer_window" />
        <!--
    <menuitem name="Server to list" id="manage" parent="manage.menu_2"
              action="manage.action_server"/>
-->
    </data>
</odoo>