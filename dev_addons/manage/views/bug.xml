<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.bug_list" model="ir.ui.view">
            <field name="name">Manage Bug List</field>
            <field name="model">manage.bug</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'done'" decoration-danger="is_paused">
                    <field name="priority" widget="priority" nolabel="1" />
                    <field name="code" />
                    <field name="name" />
                    <field name="project" optional="show" />
                    <field name="history" optional="show" />
                    <field name="sprint" optional="show" />
                    <field name="developer" widget="many2many_tags_avatar" optional="show" />
                    <field name="technology" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" />
                    <field name="start_date" optional="hide" />
                    <field name="end_date" optional="hide" />
                    <field name="is_paused" optional="hide" />
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
                </tree>
            </field>
        </record>

        <record id="manage.bug_kanban" model="ir.ui.view">
            <field name="name">Manage Bug Kanban</field>
            <field name="model">manage.bug</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" quick_create="0">
                    <field name="color" />
                    <field name="is_paused" />
                    <field name="state" />
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Menu">
                                        <span class="fa fa-ellipsis-v" />
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        <ul class="oe_kanban_colorpicker" data-field="color" />
                                    </div>
                                </div>
                                <div class="oe_kanban_content p-1">
                                    <div class="text-muted small"><field name="code" /></div>
                                    <strong class="o_kanban_record_title"><field name="name" /></strong>
                                    <div class="text-muted small">
                                        <field name="project" /> <t t-if="record.history.raw_value">/ <field name="history" /></t>
                                    </div>
                                    <div class="mt-1"><field name="technology" widget="many2many_tags" options="{'color_field': 'color'}" /></div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority" />
                                            <span t-if="record.is_paused.raw_value" class="badge text-bg-danger ms-1">Paused</span>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="developer" widget="many2many_tags_avatar" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="manage.bug_form" model="ir.ui.view">
            <field name="name">Manage Bug Form</field>
            <field name="model">manage.bug</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'todo'" />
                        <button name="action_review" type="object" string="Send to Review" class="btn-primary" invisible="state != 'in_progress'" />
                        <button name="action_done" type="object" string="Mark as Done" class="btn-primary" invisible="state not in ('in_progress', 'review')" />
                        <button name="action_toggle_pause" type="object" string="Pause" invisible="state != 'in_progress' or is_paused" />
                        <button name="action_toggle_pause" type="object" string="Resume" class="btn-primary" invisible="not is_paused" />
                        <button name="action_reset" type="object" string="Reopen" invisible="state != 'done'" />
                        <field name="state" widget="statusbar" options="{'clickable': '1'}" />
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Paused" bg_color="text-bg-danger" invisible="not is_paused" />
                        <div class="oe_title">
                            <div class="text-muted"><field name="code" readonly="1" /></div>
                            <h1 class="d-flex">
                                <field name="priority" widget="priority" class="me-3" />
                                <field name="name" placeholder="Bug title..." />
                            </h1>
                        </div>
                        <group>
                            <group string="Context">
                                <field name="history" />
                                <field name="project" />
                                <field name="sprint" />
                            </group>
                            <group string="Schedule">
                                <field name="definition_date" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="is_paused" />
                            </group>
                        </group>
                        <group>
                            <field name="developer" domain="[('is_dev', '=', True)]" context="{'form_view_ref': 'manage.devs_partner_form', 'default_is_dev': True}" widget="many2many_tags_avatar" />
                            <field name="technology" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </group>
                        <notebook>
                            <page name="description" string="Description">
                                <field name="description" placeholder="Describe the bug..." />
                            </page>
                            <page name="links" string="Linked Items">
                                <group>
                                    <field name="task_linked" widget="many2many_tags" />
                                    <field name="bug_linked" widget="many2many_tags" />
                                    <field name="improvement_linked" widget="many2many_tags" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="manage.bug_search" model="ir.ui.view">
            <field name="name">Manage Bug Search</field>
            <field name="model">manage.bug</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="project" />
                    <field name="history" />
                    <field name="developer" />
                    <field name="technology" />
                    <filter name="open" string="Open" domain="[('state', '!=', 'done')]" />
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                    <filter name="paused" string="Paused" domain="[('is_paused', '=', True)]" />
                    <separator />
                    <filter name="high_priority" string="High Priority" domain="[('priority', 'in', ('2', '3'))]" />
                    <filter name="in_sprint" string="In Current Sprint" domain="[('sprint', '!=', False)]" />
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                        <filter name="group_project" string="Project" context="{'group_by': 'project'}" />
                        <filter name="group_history" string="History" context="{'group_by': 'history'}" />
                        <filter name="group_sprint" string="Sprint" context="{'group_by': 'sprint'}" />
                        <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="manage.action_bug_window" model="ir.actions.act_window">
            <field name="name">Bugs</field>
            <field name="res_model">manage.bug</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="manage.bug_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first bug</p>
                <p>Move it through To Do, In Progress, In Review and Done from the board.</p>
            </field>
        </record>

        <menuitem id="manage.menu_1_bug_list" name="Bugs" parent="manage.menu_work" action="manage.action_bug_window" sequence="20" />
    </data>
</odoo>
