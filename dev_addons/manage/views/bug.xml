<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.bug_form" model="ir.ui.view">
            <field name="name">manage bug form</field>
            <field name="model">manage.bug</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="definition_date" />
                        <field name="project" />
                        <field name="history" />
                        <field name="code" />
                        <field name="name" />
                        <field name="description" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="is_paused" />
                        <field name="sprint" />
                        <field name="developer" domain="[('is_dev', '=', True)]" context="{'form_view_ref':'manage.devs_partner_form'}" />
                        <field name="technology" />
                        <field name="task_linked" />
                        <field name="bug_linked" />
                        <field name="improvement_linked" />
                    </group>
                </form>
            </field>
        </record>

        <record id="manage.action_bug_window" model="ir.actions.act_window">
            <field name="name">manage bug window</field>
            <field name="res_model">manage.bug</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="manage.menu_1_bug_list" name="Bugs" parent="manage.menu_1" action="manage.action_bug_window" />
    </data>
</odoo>