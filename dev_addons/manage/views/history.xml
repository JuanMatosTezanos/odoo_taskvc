<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manage.history_form" model="ir.ui.view">
            <field name="name">manage history form</field>
            <field name="model">manage.history</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="project" />
                        <field name="tasks" />
                        <field name="used_technologies" />
                    </group>
                </form>
            </field>
        </record>

        <record id="manage.action_history_window" model="ir.actions.act_window">
            <field name="name">manage history window</field>
            <field name="res_model">manage.history</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="manage.menu_1_history_list" name="History" parent="manage.menu_1" action="manage.action_history_window" />
    </data>
</odoo>