<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="devs_partner_form_inherit" model="ir.ui.view">
        <field name="name">manage.developer.form.plus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="manage.devs_partner_form" />
        <field name="arch" type="xml">
            <!-- Bugs and improvements are issue types now; their old lists are always empty. -->
            <xpath expr="//button[@name='action_view_dev_bugs']" position="replace" />
            <xpath expr="//button[@name='action_view_dev_improvements']" position="replace" />
            <xpath expr="//page[@name='dev_bugs']" position="replace" />
            <xpath expr="//page[@name='dev_improvements']" position="replace" />
            <xpath expr="//button[@name='action_view_dev_tasks']/field[@name='dev_task_count']" position="attributes">
                <attribute name="string">Issues</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_dev_tasks']" position="after">
                <button name="action_view_dev_tasks" type="object" class="oe_stat_button" icon="fa-user" invisible="not is_dev">
                    <field name="open_item_count" widget="statinfo" string="Open" />
                </button>
            </xpath>
            <!-- The base form only had a hidden is_dev, so an existing contact
                 (like your own) could never be turned into a developer. -->
            <xpath expr="//field[@name='access_level']/../.." position="before">
                <group>
                    <!-- Plain checkbox: a toggle widget would save at once and fail the
                         "developers need an access code" check before the code is typed. -->
                    <field name="is_dev" string="Developer" />
                </group>
            </xpath>
            <!-- Base rule "id and access_level" looked at the typed value: on an
                 existing contact the field locked itself while typing, so the code
                 was never sent on save ("access code required"). -->
            <field name="access_level" position="attributes">
                <attribute name="readonly">access_code_locked</attribute>
            </field>
            <field name="access_level" position="after">
                <field name="access_code_locked" invisible="1" />
            </field>
            <page name="dev_tasks" position="attributes">
                <attribute name="string">Issues</attribute>
            </page>
            <xpath expr="//page[@name='dev_tasks']/field[@name='task']/tree/field[@name='name']" position="before">
                <field name="issue_type" />
                <field name="code" string="Key" />
            </xpath>
        </field>
    </record>

    <record id="action_my_developer_profile" model="ir.actions.server">
        <field name="name">My Developer Profile</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_developer_profile()</field>
    </record>

    <menuitem id="menu_my_developer_profile" name="My Developer Profile" parent="manage.menu_team" action="action_my_developer_profile" sequence="5" />

    <record id="devs_partner_tree_inherit" model="ir.ui.view">
        <field name="name">manage.developer.list.plus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="manage.devs_partner_tree" />
        <field name="arch" type="xml">
            <field name="dev_task_count" position="attributes">
                <attribute name="string">Issues</attribute>
            </field>
            <field name="dev_bug_count" position="replace">
                <field name="open_item_count" string="Open" optional="show" />
            </field>
        </field>
    </record>

    <record id="devs_partner_search_inherit" model="ir.ui.view">
        <field name="name">manage.developer.search.plus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="manage.devs_partner_search" />
        <field name="arch" type="xml">
            <filter name="with_tasks" position="attributes">
                <attribute name="string">With Issues</attribute>
            </filter>
            <filter name="with_bugs" position="replace" />
        </field>
    </record>
</odoo>
