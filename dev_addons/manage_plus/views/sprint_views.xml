<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sprint_list_inherit" model="ir.ui.view">
        <field name="name">manage.sprint.list.plus</field>
        <field name="model">manage.sprint</field>
        <field name="inherit_id" ref="manage.sprint_list" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-info">state == 'running'</attribute>
                <attribute name="decoration-muted">state == 'closed'</attribute>
                <attribute name="decoration-warning">False</attribute>
            </xpath>
            <field name="name" position="after">
                <field name="goal" optional="show" />
            </field>
            <field name="task_count" position="replace">
                <field name="item_count" />
                <field name="planned_points" optional="show" sum="Total" />
                <field name="done_points" optional="hide" sum="Total" />
            </field>
            <field name="active" position="replace">
                <field name="state" widget="badge" decoration-success="state == 'running'" decoration-info="state == 'planned'" />
            </field>
        </field>
    </record>

    <record id="sprint_form_inherit" model="ir.ui.view">
        <field name="name">manage.sprint.form.plus</field>
        <field name="model">manage.sprint</field>
        <field name="inherit_id" ref="manage.sprint_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_start" type="object" string="Start Sprint" class="btn-primary" invisible="state != 'planned'" />
                    <button name="action_open_complete_wizard" type="object" string="Complete Sprint" class="btn-primary" invisible="state != 'running'" />
                    <field name="state" widget="statusbar" />
                </header>
            </xpath>
            <!-- Base ribbons are [1] "Running" and [2] "Not running"; replace [2] first. -->
            <xpath expr="//widget[@name='web_ribbon'][2]" position="replace">
                <widget name="web_ribbon" title="Closed" bg_color="text-bg-secondary" invisible="state != 'closed' or not active" />
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][1]" position="replace">
                <widget name="web_ribbon" title="Running" bg_color="text-bg-success" invisible="state != 'running' or not active" />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <field name="goal" placeholder="Sprint goal, e.g. Users can reset their password" />
            </xpath>
            <field name="end_date" position="attributes">
                <attribute name="readonly">state != 'closed'</attribute>
            </field>
            <field name="task_count" position="replace">
                <field name="item_count" />
                <field name="done_count" />
                <label for="planned_points" string="Story Points" />
                <div class="o_row">
                    <field name="done_points" /> <span>/</span> <field name="planned_points" />
                </div>
            </field>
            <page name="tasks" position="attributes">
                <attribute name="string">Issues</attribute>
            </page>
            <xpath expr="//page[@name='tasks']/field[@name='tasks']/tree/field[@name='developer']" position="replace">
                <field name="issue_type" />
                <field name="assignee" widget="many2one_avatar" />
                <field name="story_points" sum="Total" />
            </xpath>
            <xpath expr="//page[@name='tasks']/field[@name='tasks']/tree/field[@name='state']" position="replace">
                <field name="state" column_invisible="1" />
                <field name="stage_id" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'review'" />
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="sprint_search_inherit" model="ir.ui.view">
        <field name="name">manage.sprint.search.plus</field>
        <field name="model">manage.sprint</field>
        <field name="inherit_id" ref="manage.sprint_search" />
        <field name="arch" type="xml">
            <filter name="running" position="replace">
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]" />
                <filter name="running" string="Running" domain="[('state', '=', 'running')]" />
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]" />
                <separator />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </filter>
            <filter name="not_running" position="replace" />
            <filter name="group_project" position="after">
                <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
            </filter>
        </field>
    </record>

    <record id="sprint_complete_form" model="ir.ui.view">
        <field name="name">manage.sprint.complete.form</field>
        <field name="model">manage.sprint.complete</field>
        <field name="arch" type="xml">
            <form>
                <field name="sprint_id" invisible="1" />
                <field name="project_id" invisible="1" />
                <p>
                    <field name="done_count" class="fw-bold" /> issue(s) are done and
                    <field name="open_count" class="fw-bold" /> are not finished.
                </p>
                <group invisible="not open_count">
                    <field name="destination" widget="radio" />
                    <field name="target_sprint_id" invisible="destination != 'sprint'" required="destination == 'sprint' and open_count" options="{'no_create': True}" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Complete Sprint" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Finished sprints are no longer archived, so no need to show archived ones. -->
    <record id="manage.action_sprint_window" model="ir.actions.act_window">
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan your first sprint</p>
            <p>Create a sprint, add issues to it from the Backlog, then press Start Sprint.</p>
        </field>
    </record>
</odoo>
