<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="history_list_inherit" model="ir.ui.view">
        <field name="name">manage.history.list.plus</field>
        <field name="model">manage.history</field>
        <field name="inherit_id" ref="manage.history_list" />
        <field name="arch" type="xml">
            <field name="task_count" position="attributes">
                <attribute name="string">Issues</attribute>
            </field>
            <field name="task_count" position="after">
                <field name="bug_count" string="Bugs" />
                <field name="progress" widget="progressbar" />
            </field>
        </field>
    </record>

    <record id="history_form_inherit" model="ir.ui.view">
        <field name="name">manage.history.form.plus</field>
        <field name="model">manage.history</field>
        <field name="inherit_id" ref="manage.history_form" />
        <field name="arch" type="xml">
            <field name="project" position="after">
                <field name="progress" widget="progressbar" />
            </field>
            <page name="tasks" position="attributes">
                <attribute name="string">Issues</attribute>
            </page>
            <xpath expr="//page[@name='tasks']/field[@name='tasks']" position="attributes">
                <attribute name="context">{'default_project': project}</attribute>
            </xpath>
            <xpath expr="//page[@name='tasks']/field[@name='tasks']/tree/field[@name='name']" position="before">
                <field name="issue_type" />
                <field name="code" string="Key" />
            </xpath>
            <xpath expr="//page[@name='tasks']/field[@name='tasks']/tree/field[@name='developer']" position="replace">
                <field name="assignee" widget="many2one_avatar" />
            </xpath>
        </field>
    </record>
</odoo>
