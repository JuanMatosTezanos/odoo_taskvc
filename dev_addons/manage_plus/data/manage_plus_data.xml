<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sprints are started and completed by hand now, so the base cron that
         flipped them by date is switched off. -->
    <record id="manage.cron_update_sprints" model="ir.cron">
        <field name="active" eval="False" />
    </record>

    <data noupdate="1">
        <!-- Folder with technology logos (Settings > Technical > System Parameters). -->
        <record id="param_tech_image_dir" model="ir.config_parameter">
            <field name="key">manage_plus.tech_image_dir</field>
            <field name="value">/tech_images</field>
        </record>

        <!-- Default board columns; add, rename or reorder them under Configuration > Board Columns. -->
        <record id="stage_todo" model="manage.stage">
            <field name="name">To Do</field>
            <field name="sequence">10</field>
            <field name="state">todo</field>
        </record>
        <record id="stage_in_progress" model="manage.stage">
            <field name="name">In Progress</field>
            <field name="sequence">20</field>
            <field name="state">in_progress</field>
        </record>
        <record id="stage_review" model="manage.stage">
            <field name="name">In Review</field>
            <field name="sequence">30</field>
            <field name="state">review</field>
        </record>
        <record id="stage_done" model="manage.stage">
            <field name="name">Done</field>
            <field name="sequence">40</field>
            <field name="state">done</field>
        </record>
    </data>
</odoo>
