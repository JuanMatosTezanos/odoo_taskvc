<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One "Projects" app: Odoo's Project app, with its own menus grouped
         under "Project" and ours under "Dev Projects":

         Projects  |  Project ▾       |  Dev Projects ▾
                   |  Projects        |  Planning: Projects, Milestones, Sprints, Components
                   |  Tasks           |  Work: Board, Backlog, Tickets
                   |  Reporting       |  Team: ...
                   |  Configuration   |  Configuration: ...

         Reports are sent from the top-bar icon (static/src/report_systray), so the
         app stays for the dev team (Project users) only.
    -->
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="name">Projects</field>
        <!-- Briefly opened to every employee for a Report menu (now the top-bar icon). -->
        <field name="groups_id" eval="[(3, ref('base.group_user'))]" />
    </record>

    <!-- ============ Project: Odoo's own menus, unchanged, one level down ============ -->
    <menuitem id="menu_project_section" name="Project" parent="project.menu_main_pm" sequence="1"
              groups="project.group_project_user" />
    <record id="project.menu_projects" model="ir.ui.menu">
        <field name="parent_id" ref="menu_project_section" />
    </record>
    <record id="project.menu_projects_group_stage" model="ir.ui.menu">
        <field name="parent_id" ref="menu_project_section" />
    </record>
    <record id="project.menu_project_management" model="ir.ui.menu">
        <field name="parent_id" ref="menu_project_section" />
    </record>
    <record id="project.menu_project_report" model="ir.ui.menu">
        <field name="parent_id" ref="menu_project_section" />
    </record>
    <record id="project.menu_project_config" model="ir.ui.menu">
        <field name="parent_id" ref="menu_project_section" />
    </record>

    <!-- ============ Dev Projects: our features ============ -->
    <menuitem id="menu_root" name="Dev Projects" parent="project.menu_main_pm" sequence="2" groups="project.group_project_user" />

    <menuitem id="menu_planning" name="Planning" parent="menu_root" sequence="10" />
    <menuitem id="menu_projects" name="Projects" parent="menu_planning" action="action_project" sequence="1" />
    <menuitem id="menu_milestones" name="Milestones" parent="menu_planning" action="action_milestone" sequence="2" />
    <menuitem id="menu_sprints" name="Sprints" parent="menu_planning" action="action_sprint" sequence="3" />
    <menuitem id="menu_modules" name="Components" parent="menu_planning" action="action_module" sequence="4" />

    <menuitem id="menu_work" name="Work" parent="menu_root" sequence="20" />

    <menuitem id="menu_board" name="Board" parent="menu_work" action="action_board" sequence="1" />
    <menuitem id="menu_backlog" name="Backlog" parent="menu_work" action="action_backlog" sequence="2" />
    <menuitem id="menu_tickets" name="Tickets" parent="menu_work" action="action_tickets" sequence="3" />

    <menuitem id="menu_team" name="Team" parent="menu_root" sequence="30" />
    <menuitem id="menu_my_profile" name="My Developer Profile" parent="menu_team" action="action_my_developer_profile" sequence="1" />
    <menuitem id="menu_developers" name="Developers" parent="menu_team" action="action_developer" sequence="2" />
    <menuitem id="menu_technologies" name="Technologies" parent="menu_team" action="action_technology" sequence="3" />

    <!-- Same configuration as the Project app (same actions), plus ours. -->
    <menuitem id="menu_config" name="Configuration" parent="menu_root" groups="project.group_project_manager" sequence="90" />
    <menuitem id="menu_config_settings" name="Settings" parent="menu_config" action="project.project_config_settings_action" groups="base.group_system" sequence="0" />
    <menuitem id="menu_stages" name="Board Columns" parent="menu_config" action="action_stage" sequence="1" />
    <menuitem id="menu_config_project_stages" name="Project Stages" parent="menu_config" action="project.project_project_stage_configure" groups="project.group_project_stages" sequence="9" />
    <menuitem id="menu_config_tags" name="Tags" parent="menu_config" action="project.project_tags_action" sequence="20" />
    <menuitem id="menu_config_activity_types" name="Activity Types" parent="menu_config" action="project.mail_activity_type_action_config_project_types" sequence="30" />
    <menuitem id="menu_config_activity_plans" name="Activity Plans" parent="menu_config" action="project.mail_activity_plan_action_config_project_task_plan" sequence="31" />


</odoo>
