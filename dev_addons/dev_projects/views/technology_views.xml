<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="technology_list" model="ir.ui.view">
        <field name="name">dev.technology.list</field>
        <field name="model">dev.technology</field>
        <field name="arch" type="xml">
            <tree>
                <field name="photo" widget="image" options="{'size': [32, 32]}" />
                <field name="name" />
                <field name="description" optional="show" />
                <field name="developer_count" string="Developers" />
                <field name="task_count" string="Issues" />
                <field name="bug_count" string="Bugs" />
            </tree>
        </field>
    </record>

    <record id="technology_kanban" model="ir.ui.view">
        <field name="name">dev.technology.kanban</field>
        <field name="model">dev.technology</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('dev.technology', 'photo', record.id.raw_value)" alt="Logo" class="o_image_64_contain" />
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name" /></strong>
                                <div class="text-muted text-truncate"><field name="description" /></div>
                                <div class="mt-2 small">
                                    <span class="me-3"><i class="fa fa-users me-1" title="Developers" /><field name="developer_count" /> devs</span>
                                    <span><i class="fa fa-tasks me-1" title="Issues" /><field name="task_count" /> issues</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="technology_form" model="ir.ui.view">
        <field name="name">dev.technology.form</field>
        <field name="model">dev.technology</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="e.g. Python" /></h1>
                    </div>
                    <group>
                        <field name="color" widget="color_picker" />
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description" />
                        </page>
                        <page name="developers" string="Developers">
                            <field name="developer_ids" domain="[('dev_is_developer', '=', True)]">
                                <tree>
                                    <field name="name" />
                                    <field name="email" />
                                    <field name="dev_access_code" />
                                </tree>
                            </field>
                        </page>
                        <page name="issues" string="Issues">
                            <field name="task_ids" context="{'form_view_ref': 'project.view_task_form2'}">
                                <tree>
                                    <field name="dev_key" />
                                    <field name="name" />
                                    <field name="project_id" />
                                    <field name="dev_status" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_technology" model="ir.actions.act_window">
        <field name="name">Technologies</field>
        <field name="res_model">dev.technology</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a technology</p>
            <p>Tag issues and developers with the technologies they use.
               A logo is picked up automatically from the image folder when the name matches.</p>
        </field>
    </record>
</odoo>
