<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dev Projects' own views of project.task. They have a high priority
         number so the Project app keeps using its own views by default. -->

    <!-- ================= Issue form ================= -->
    <record id="task_form" model="ir.ui.view">
        <field name="name">dev.issue.form</field>
        <field name="model">project.task</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Issue">
                <header>
                    <button name="action_dev_start" type="object" string="Start" class="btn-primary" invisible="dev_status != 'todo' or not id" />
                    <button name="action_dev_review" type="object" string="Send to Review" class="btn-primary" invisible="dev_status != 'in_progress'" />
                    <button name="action_dev_done" type="object" string="Mark as Done" class="btn-primary" invisible="dev_status not in ('in_progress', 'review')" />
                    <button name="action_dev_toggle_pause" type="object" string="Pause" invisible="dev_status != 'in_progress' or dev_is_paused" />
                    <button name="action_dev_toggle_pause" type="object" string="Resume" class="btn-primary" invisible="not dev_is_paused" />
                    <button name="action_dev_reopen" type="object" string="Reopen" invisible="dev_status != 'done'" />
                    <button name="action_dev_open_complete_wizard" type="object" string="Complete" class="btn-success" invisible="not active or not id" help="Mark as done, then archive or delete it" />
                    <button name="action_dev_assign_to_me" type="object" string="Assign to Me" invisible="dev_status == 'done'" />
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" domain="[('project_ids', '=', project_id)]" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <field name="dev_status" invisible="1" />
                    <field name="dev_is_overdue" invisible="1" />
                    <field name="state" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active" />
                    <widget name="web_ribbon" title="Paused" bg_color="text-bg-danger" invisible="not dev_is_paused or not active" />
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-warning" invisible="not dev_is_overdue or dev_is_paused or not active" />
                    <div class="mb-2">
                        <field name="dev_issue_type" widget="radio" options="{'horizontal': true}" />
                    </div>
                    <div class="oe_title">
                        <div class="text-muted"><field name="dev_key" readonly="1" /></div>
                        <h1 class="d-flex">
                            <field name="dev_priority" widget="priority" class="me-3" />
                            <field name="name" placeholder="Summary..." />
                        </h1>
                    </div>
                    <group>
                        <group string="Planning">
                            <field name="project_id" required="1" options="{'no_create': True}" />
                            <field name="dev_history_id" options="{'no_create': True}" />
                            <field name="dev_sprint_id" options="{'no_create': True}" readonly="dev_status == 'done'" />
                            <field name="dev_story_points" />
                            <field name="dev_severity" invisible="dev_issue_type != 'bug'" required="dev_issue_type == 'bug'" widget="badge" decoration-danger="dev_severity in ('critical', 'blocker')" decoration-warning="dev_severity == 'major'" />
                        </group>
                        <group string="People">
                            <field name="dev_assignee_id" widget="many2one_avatar_user" options="{'no_create': True}" />
                            <field name="dev_reporter_id" widget="many2one_avatar_user" options="{'no_create': True}" />
                            <field name="user_ids" string="Team" widget="many2many_avatar_user" options="{'no_create': True}" help="Everyone working on it (the Project app's Assignees). The assignee is added automatically." />
                            <field name="dev_technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" />
                        </group>
                        <group string="Schedule">
                            <field name="create_date" string="Created On" readonly="1" />
                            <field name="dev_start_date" />
                            <field name="dev_end_date" />
                            <field name="date_deadline" decoration-danger="dev_is_overdue" />
                            <field name="dev_is_paused" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description" placeholder="Describe the issue..." />
                        </page>
                        <page name="subtasks" string="Sub-tasks" invisible="not id">
                            <field name="child_ids" context="{'default_project_id': project_id, 'default_parent_id': id, 'default_dev_sprint_id': dev_sprint_id, 'default_dev_history_id': dev_history_id}">
                                <tree editable="bottom">
                                    <field name="dev_key" readonly="1" />
                                    <field name="name" />
                                    <field name="dev_assignee_id" widget="many2one_avatar_user" />
                                    <field name="dev_story_points" />
                                    <field name="stage_id" readonly="1" />
                                    <field name="project_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- ================= Issue list ================= -->
    <record id="task_list" model="ir.ui.view">
        <field name="name">dev.issue.list</field>
        <field name="model">project.task</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree string="Issues" decoration-muted="dev_status == 'done'" decoration-danger="dev_is_paused" decoration-warning="dev_is_overdue">
                <field name="dev_priority" widget="priority" nolabel="1" />
                <field name="dev_issue_type" />
                <field name="dev_key" />
                <field name="name" />
                <field name="project_id" optional="show" />
                <field name="dev_history_id" optional="show" />
                <field name="dev_sprint_id" optional="show" />
                <field name="dev_assignee_id" widget="many2one_avatar_user" optional="show" />
                <field name="dev_story_points" optional="show" sum="Total" />
                <field name="dev_severity" invisible="dev_issue_type != 'bug'" widget="badge" decoration-danger="dev_severity in ('critical', 'blocker')" decoration-warning="dev_severity == 'major'" optional="hide" />
                <field name="dev_technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" />
                <field name="date_deadline" widget="remaining_days" invisible="dev_status == 'done'" optional="show" />
                <field name="dev_start_date" optional="hide" />
                <field name="dev_end_date" optional="hide" />
                <field name="stage_id" widget="badge" decoration-success="dev_status == 'done'" decoration-info="dev_status == 'in_progress'" decoration-warning="dev_status == 'review'" />
                <field name="dev_status" column_invisible="1" />
                <field name="dev_is_paused" column_invisible="1" />
                <field name="dev_is_overdue" column_invisible="1" />
            </tree>
        </field>
    </record>

    <!-- ================= Board (kanban) ================= -->
    <record id="task_quick_create_form" model="ir.ui.view">
        <field name="name">dev.issue.quick.create</field>
        <field name="model">project.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="Summary..." />
                    <field name="project_id" required="1" options="{'no_create': True}" />
                    <field name="dev_issue_type" />
                    <field name="dev_assignee_id" widget="many2one_avatar_user" options="{'no_create': True}" />
                    <field name="company_id" invisible="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="task_kanban" model="ir.ui.view">
        <field name="name">dev.issue.kanban</field>
        <field name="model">project.task</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="1"
                    quick_create_view="dev_projects.task_quick_create_form" sample="1">
                <field name="color" />
                <field name="dev_status" />
                <field name="dev_issue_type" />
                <field name="dev_severity" />
                <field name="dev_story_points" />
                <field name="dev_is_paused" />
                <field name="dev_history_id" />
                <field name="active" />
                <progressbar field="dev_status" colors='{"done": "success", "in_progress": "info", "review": "warning", "todo": "muted"}' />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Menu">
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                    <a role="menuitem" name="action_dev_open_complete_wizard" type="object" class="dropdown-item">Complete</a>
                                    <ul class="oe_kanban_colorpicker" data-field="color" />
                                </div>
                            </div>
                            <div class="oe_kanban_content p-1">
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <i t-if="record.dev_issue_type.raw_value == 'story'" class="fa fa-bookmark text-success" title="Story" />
                                    <i t-if="record.dev_issue_type.raw_value == 'task'" class="fa fa-check-square text-primary" title="Task" />
                                    <i t-if="record.dev_issue_type.raw_value == 'bug'" class="fa fa-bug text-danger" title="Bug" />
                                    <i t-if="record.dev_issue_type.raw_value == 'improvement'" class="fa fa-arrow-circle-up text-info" title="Improvement" />
                                    <field name="dev_key" />
                                </div>
                                <strong class="o_kanban_record_title"><field name="name" /></strong>
                                <div class="text-muted small">
                                    <field name="project_id" /> <t t-if="record.dev_history_id.raw_value">/ <field name="dev_history_id" /></t>
                                </div>
                                <div class="mt-1"><field name="dev_technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" /></div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="dev_priority" widget="priority" />
                                        <field name="activity_ids" widget="kanban_activity" />
                                        <field name="date_deadline" widget="remaining_days" invisible="dev_status == 'done'" />
                                        <span t-if="record.dev_is_paused.raw_value" class="badge text-bg-danger ms-1">Paused</span>
                                        <span t-if="record.dev_issue_type.raw_value == 'bug' and ['critical', 'blocker'].includes(record.dev_severity.raw_value)" class="badge text-bg-danger ms-1">
                                            <t t-esc="record.dev_severity.value" />
                                        </span>
                                        <span t-if="record.dev_story_points.raw_value" class="badge rounded-pill text-bg-light ms-1" title="Story points">
                                            <t t-esc="record.dev_story_points.value" />
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="dev_assignee_id" widget="many2one_avatar_user" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================= Search ================= -->
    <!-- Starts from the Project app's task search (so its filters stay available)
         and adds the Dev filters; all named dev_* to avoid clashing with it. -->
    <record id="task_search" model="ir.ui.view">
        <field name="name">dev.issue.search</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('dev_key', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="dev_key" string="Key" />
                <field name="dev_assignee_id" />
                <field name="dev_sprint_id" />
                <field name="dev_history_id" />
                <field name="dev_technology_ids" />
            </field>
            <xpath expr="//search/filter[1]" position="before">
                <filter name="dev_current_work" string="Current Work" domain="['|', ('dev_sprint_id', '=', False), ('dev_sprint_id.state', '=', 'running')]" help="The running sprint plus issues not planned in any sprint" />
                <filter name="dev_active_sprint" string="Active Sprint" domain="[('dev_sprint_id.state', '=', 'running')]" />
                <filter name="dev_backlog" string="Not in a Sprint" domain="[('dev_sprint_id', '=', False)]" />
                <separator />
                <filter name="dev_my_issues" string="Assigned to Me" domain="[('dev_assignee_id', '=', uid)]" />
                <filter name="dev_reported" string="Reported by Me" domain="[('dev_reporter_id', '=', uid)]" />
                <filter name="dev_unassigned" string="No Assignee" domain="[('dev_assignee_id', '=', False)]" />
                <separator />
                <filter name="dev_type_story" string="Stories" domain="[('dev_issue_type', '=', 'story')]" />
                <filter name="dev_type_task" string="Tasks" domain="[('dev_issue_type', '=', 'task')]" />
                <filter name="dev_type_bug" string="Bugs" domain="[('dev_issue_type', '=', 'bug')]" />
                <filter name="dev_type_improvement" string="Improvements" domain="[('dev_issue_type', '=', 'improvement')]" />
                <separator />
                <filter name="dev_open" string="Open" domain="[('dev_status', '!=', 'done')]" />
                <filter name="dev_done" string="Done" domain="[('dev_status', '=', 'done')]" />
                <filter name="dev_overdue" string="Overdue" domain="[('dev_is_overdue', '=', True)]" />
                <filter name="dev_paused" string="Paused" domain="[('dev_is_paused', '=', True)]" />
                <filter name="dev_high_priority" string="High Priority" domain="[('dev_priority', 'in', ('2', '3'))]" />
                <filter name="dev_blocking" string="Critical / Blocker Bugs" domain="[('dev_issue_type', '=', 'bug'), ('dev_severity', 'in', ('critical', 'blocker'))]" />
                <separator />
                <filter name="dev_archived" string="Archived" domain="[('active', '=', False)]" />
                <separator />
            </xpath>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Dev Group By">
                    <filter name="dev_group_stage" string="Column" context="{'group_by': 'stage_id'}" />
                    <filter name="dev_group_type" string="Type" context="{'group_by': 'dev_issue_type'}" />
                    <filter name="dev_group_assignee" string="Assignee" context="{'group_by': 'dev_assignee_id'}" />
                    <filter name="dev_group_sprint" string="Sprint" context="{'group_by': 'dev_sprint_id'}" />
                    <filter name="dev_group_history" string="History" context="{'group_by': 'dev_history_id'}" />
                    <filter name="dev_group_project" string="Project" context="{'group_by': 'project_id'}" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- ================= Backlog ================= -->
    <record id="task_backlog_list" model="ir.ui.view">
        <field name="name">dev.issue.backlog.list</field>
        <field name="model">project.task</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <tree editable="bottom" multi_edit="1" decoration-warning="dev_is_overdue">
                <field name="sequence" widget="handle" />
                <field name="dev_issue_type" />
                <field name="dev_key" readonly="1" />
                <field name="name" />
                <field name="project_id" optional="show" options="{'no_create': True}" required="1" />
                <field name="dev_history_id" optional="hide" options="{'no_create': True}" />
                <field name="dev_assignee_id" widget="many2one_avatar_user" optional="show" options="{'no_create': True}" />
                <field name="dev_priority" widget="priority" optional="show" />
                <field name="dev_story_points" sum="Total" />
                <field name="dev_sprint_id" options="{'no_create': True}" />
                <field name="stage_id" optional="show" options="{'no_create': True}" domain="[('project_ids', '=', project_id)]" />
                <field name="dev_status" column_invisible="1" />
                <field name="dev_is_overdue" column_invisible="1" />
                <field name="company_id" column_invisible="1" />
            </tree>
        </field>
    </record>

    <!-- ================= Reporting ================= -->
    <record id="task_pivot" model="ir.ui.view">
        <field name="name">dev.issue.pivot</field>
        <field name="model">project.task</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Issues" sample="1">
                <field name="project_id" type="row" />
                <field name="dev_issue_type" type="col" />
                <field name="dev_story_points" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="task_graph" model="ir.ui.view">
        <field name="name">dev.issue.graph</field>
        <field name="model">project.task</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Issues" type="bar" stacked="1" sample="1">
                <field name="dev_sprint_id" />
                <field name="dev_status" />
            </graph>
        </field>
    </record>

    <!-- ================= Actions ================= -->
    <!-- The one board: opens on current work (running sprint + issues not in a
         sprint); removing that filter shows every issue. -->
    <record id="action_board" model="ir.actions.act_window">
        <field name="name">Board</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
        <field name="search_view_id" ref="task_search" />
        <field name="domain">[('project_id', '!=', False), ('display_in_project', '=', True)]</field>
        <field name="context">{'dev_board': True, 'search_default_dev_current_work': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing on the board yet</p>
            <p>Create an issue here. Remove the "Current Work" filter to see every issue,
               or use "Archived" to find completed ones you archived.</p>
        </field>
    </record>
    <record id="action_board_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="task_kanban" />
        <field name="act_window_id" ref="action_board" />
    </record>
    <record id="action_board_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="task_list" />
        <field name="act_window_id" ref="action_board" />
    </record>
    <record id="action_board_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="task_form" />
        <field name="act_window_id" ref="action_board" />
    </record>
    <record id="action_board_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">4</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="task_pivot" />
        <field name="act_window_id" ref="action_board" />
    </record>
    <record id="action_board_view_graph" model="ir.actions.act_window.view">
        <field name="sequence">5</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="task_graph" />
        <field name="act_window_id" ref="action_board" />
    </record>

    <record id="action_backlog" model="ir.actions.act_window">
        <field name="name">Backlog</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="task_search" />
        <field name="domain">[('project_id', '!=', False), ('display_in_project', '=', True), ('dev_status', '!=', 'done'), '|', ('dev_sprint_id', '=', False), ('dev_sprint_id.state', '!=', 'closed')]</field>
        <field name="context">{'dev_board': True, 'group_by': 'dev_sprint_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your backlog is empty</p>
            <p>Add issues here, drag them to rank them, and pick a sprint in the Sprint column to plan it.
               Issues without a sprint are grouped under "None".</p>
        </field>
    </record>
    <record id="action_backlog_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="task_backlog_list" />
        <field name="act_window_id" ref="action_backlog" />
    </record>
    <record id="action_backlog_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="task_form" />
        <field name="act_window_id" ref="action_backlog" />
    </record>

    <!-- ================= Complete issues ================= -->
    <record id="task_complete_form" model="ir.ui.view">
        <field name="name">dev.task.complete.form</field>
        <field name="model">dev.task.complete</field>
        <field name="arch" type="xml">
            <form>
                <p>The issue(s) below will be marked as done and taken off the board.</p>
                <field name="task_ids" widget="many2many_tags" readonly="1" />
                <group>
                    <field name="mode" widget="radio" />
                </group>
                <p class="text-muted" invisible="mode != 'archive'">
                    Archived issues keep their history and comments. Find them again with the "Archived" filter.
                </p>
                <p class="text-danger" invisible="mode != 'delete'">
                    Deleting cannot be undone.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Complete" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- In the list's Action menu, for several issues at once. -->
    <record id="action_task_complete" model="ir.actions.act_window">
        <field name="name">Complete</field>
        <field name="res_model">dev.task.complete</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="project.model_project_task" />
        <field name="binding_view_types">list,kanban</field>
    </record>
</odoo>
