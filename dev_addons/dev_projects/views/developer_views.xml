<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Developer form: the contact form plus the developer profile. -->
    <record id="developer_form" model="ir.ui.view">
        <field name="name">dev.developer.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dev_view_issues" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not dev_is_developer or not user_ids">
                    <field name="dev_open_issue_count" widget="statinfo" string="Open Issues" />
                </button>
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <!-- Plain checkbox: a toggle would save at once and fail the
                     "developers need an access code" check before it is typed. -->
                <group>
                    <field name="dev_is_developer" />
                </group>
                <group invisible="not dev_is_developer">
                    <group>
                        <field name="dev_access_code" readonly="dev_access_code_locked" required="dev_is_developer" placeholder="12345678A" />
                        <field name="dev_access_code_locked" invisible="1" />
                        <field name="dev_last_login" />
                    </group>
                    <group>
                        <field name="dev_technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                        <field name="dev_issue_count" />
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not dev_is_developer or user_ids">
                    Issues are assigned to Odoo users. Give this developer a user
                    (Settings &gt; Users) to assign issues to them.
                </div>
            </xpath>
        </field>
    </record>

    <record id="developer_list" model="ir.ui.view">
        <field name="name">dev.developer.list</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="dev_access_code" />
                <field name="email" optional="show" />
                <field name="phone" optional="hide" />
                <field name="dev_technology_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                <field name="dev_open_issue_count" />
                <field name="dev_last_login" optional="show" />
            </tree>
        </field>
    </record>

    <record id="developer_search" model="ir.ui.view">
        <field name="name">dev.developer.search</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="dev_access_code" />
                <field name="dev_technology_ids" />
                <filter name="with_user" string="Can Be Assigned" domain="[('user_ids', '!=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_developer" model="ir.actions.act_window">
        <field name="name">Developers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('dev_is_developer', '=', True)]</field>
        <field name="context">{'default_dev_is_developer': True}</field>
        <field name="search_view_id" ref="developer_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first developer</p>
            <p>Developers have an access code and technologies. To assign issues to them,
               they also need an Odoo user.</p>
        </field>
    </record>
    <record id="action_developer_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="base.res_partner_kanban_view" />
        <field name="act_window_id" ref="action_developer" />
    </record>
    <record id="action_developer_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="developer_list" />
        <field name="act_window_id" ref="action_developer" />
    </record>
    <record id="action_developer_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="developer_form" />
        <field name="act_window_id" ref="action_developer" />
    </record>

    <!-- Server action on project.project: every project user may run it, and
         it only opens a form (saving is checked by normal access rights). -->
    <record id="action_my_developer_profile" model="ir.actions.server">
        <field name="name">My Developer Profile</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="state">code</field>
        <field name="code">action = env['res.partner'].action_dev_my_profile()</field>
    </record>
</odoo>
