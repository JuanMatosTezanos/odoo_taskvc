<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dev_projects.ReportSystray">
        <Dropdown class="'o_dev_report_systray'" position="'bottom-end'" autoOpen="false" tooltip="tooltip">
            <t t-set-slot="toggler">
                <i class="fa fa-lg fa-bullhorn" role="img" aria-label="Report a problem or an idea"/>
            </t>
            <DropdownItem onSelected="() => this.newReport()">
                <i class="fa fa-plus me-2"/>New Report
            </DropdownItem>
            <DropdownItem onSelected="() => this.myReports()">
                <i class="fa fa-list me-2"/>My Reports
            </DropdownItem>
        </Dropdown>
    </t>
</templates>
