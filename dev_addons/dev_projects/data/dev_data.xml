<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default board columns, linked to every new project. user_id must be
             empty, otherwise Odoo treats a stage without projects as a
             personal stage of the user installing the module. -->
        <record id="stage_todo" model="project.task.type">
            <field name="name">To Do</field>
            <field name="sequence">10</field>
            <field name="dev_category">todo</field>
            <field name="user_id" eval="False" />
        </record>
        <record id="stage_in_progress" model="project.task.type">
            <field name="name">In Progress</field>
            <field name="sequence">20</field>
            <field name="dev_category">in_progress</field>
            <field name="user_id" eval="False" />
        </record>
        <record id="stage_review" model="project.task.type">
            <field name="name">In Review</field>
            <field name="sequence">30</field>
            <field name="dev_category">review</field>
            <field name="user_id" eval="False" />
        </record>
        <record id="stage_done" model="project.task.type">
            <field name="name">Done</field>
            <field name="sequence">40</field>
            <field name="dev_category">done</field>
            <field name="user_id" eval="False" />
        </record>

        <!-- Folder with technology logos (Settings > Technical > System Parameters). -->
        <record id="param_tech_image_dir" model="ir.config_parameter">
            <field name="key">dev_projects.tech_image_dir</field>
            <field name="value">/tech_images</field>
        </record>
    </data>
</odoo>
